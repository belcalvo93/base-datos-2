# Secretos — nunca se versionan
.env

# Respaldos de base de datos (binarios, se regeneran)
food-store/backups/*.dump
food-store/backups/*.backup
*.dump
*.backup

# Conteo de referencia del respaldo de mantenimiento (se regenera con backup_foodstore.sh)
mantenimiento/backups/*.conteo

# Dependencias y logs
node_modules/
*.log

# TP6: los logs de mantenimiento SI se versionan (son evidencia)
!mantenimiento/logs/*.log
